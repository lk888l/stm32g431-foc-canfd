{
    "version": 6,
    "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
    "configurePresets": [
        {
            "name": "firmware",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake"
        },
        {"name": "Debug", "inherits": "firmware", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
        {"name": "Release", "inherits": "firmware", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
        {
            "name": "Host",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Host",
            "cacheVariables": {"ROLLER_HOST_TESTS": "ON", "CMAKE_BUILD_TYPE": "Debug"}
        }
    ],
    "buildPresets": [
        {"name": "Debug", "configurePreset": "Debug"},
        {"name": "Release", "configurePreset": "Release"},
        {"name": "Host", "configurePreset": "Host"}
    ],
    "testPresets": [
        {"name": "Host", "configurePreset": "Host", "output": {"outputOnFailure": true}}
    ]
}
